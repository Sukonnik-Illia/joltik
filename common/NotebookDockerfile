FROM jupyter/minimal-notebook:latest

# Install JupyterLab and extensions
RUN pip install --upgrade jupyterlab
RUN pip install --upgrade jupyterlab-lsp
RUN pip install --upgrade python-lsp-server
RUN pip install --upgrade jupyterlab-git
RUN pip install --upgrade lckr-jupyterlab-variableinspector
RUN pip install --upgrade jupyterlab-code-formatter
RUN pip install --upgrade black
RUN pip install --upgrade isort
RUN pip install --upgrade pandas
# (Optional) Install additional system packages if needed
# RUN apt-get update && apt-get upgrade

# Set the command to start JupyterLab
CMD ["start-notebook.sh", "--NotebookApp.token='your_token'"]
